<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        fx:id="rootPane"
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.infectedhour.fxlauncher.views.MainMenuController"
        styleClass="menu-root"
        minWidth="900" minHeight="560">

    <Region styleClass="menu-overlay"/>
    <Region styleClass="menu-bottom-fade" StackPane.alignment="BOTTOM_CENTER"/>

    <AnchorPane styleClass="menu-content">
        <VBox spacing="1" AnchorPane.leftAnchor="66" AnchorPane.topAnchor="34">
            <Label text="THE INFECTED HOUR" styleClass="top-brand"/>
            <Label text="ASHGROVE INCIDENT // ACTIVE" styleClass="menu-brand-subtitle"/>
        </VBox>

        <VBox alignment="CENTER_RIGHT" spacing="2"
              AnchorPane.rightAnchor="58" AnchorPane.topAnchor="34">
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Label fx:id="statusChip" text="●  offline" styleClass="chip-searching"/>
                <Label fx:id="usernameLabel" text="Guest" styleClass="player-name"/>
            </HBox>
            <Label fx:id="versionLabel" text="v0.1-alpha" styleClass="version-label"/>
        </VBox>

        <VBox spacing="8" prefWidth="350"
              AnchorPane.leftAnchor="66" AnchorPane.topAnchor="132">
            <Label text="MAIN MENU" styleClass="horror-menu-heading"/>
            <Region prefHeight="8"/>

            <Button fx:id="singlePlayerBtn" text="SINGLE PLAYER STORY"
                    prefWidth="350" prefHeight="42"
                    styleClass="horror-menu-item, horror-menu-item-primary"
                    onAction="#onSinglePlayer"/>
            <Button fx:id="coopButton" text="MULTIPLAYER STORY"
                    prefWidth="350" prefHeight="42"
                    styleClass="horror-menu-item"
                    onAction="#onCoopMode"/>
            <Button fx:id="continueButton" text="LOAD SAVED GAMES"
                    prefWidth="350" prefHeight="42"
                    styleClass="horror-menu-item"
                    onAction="#onLoadGame"/>
            <Button fx:id="settingsButton" text="OPTIONS"
                    prefWidth="350" prefHeight="42"
                    styleClass="horror-menu-item"
                    onAction="#onSettings"/>
            <Button fx:id="intelButton" text="ABOUT"
                    prefWidth="350" prefHeight="42"
                    styleClass="horror-menu-item"
                    onAction="#onAbout"/>

            <Region prefHeight="9"/>
            <Label text="DEVELOPER" styleClass="horror-menu-section"/>
            <Button fx:id="debugButton" text="DEBUG CO-OP"
                    prefWidth="350" prefHeight="36"
                    styleClass="horror-menu-item, horror-menu-item-developer"
                    onAction="#onDebugCoop"/>
            <Button fx:id="bossButton" text="FINAL BOSS TEST"
                    prefWidth="350" prefHeight="36"
                    styleClass="horror-menu-item, horror-menu-item-developer"
                    onAction="#onFinalBossFight"/>

            <Region prefHeight="5"/>
            <Button fx:id="exitButton" text="EXIT"
                    prefWidth="350" prefHeight="42"
                    styleClass="horror-menu-item, horror-menu-item-danger"
                    onAction="#onQuit"/>
        </VBox>

        <VBox alignment="CENTER" spacing="7"
              AnchorPane.leftAnchor="430" AnchorPane.rightAnchor="70"
              AnchorPane.bottomAnchor="32">
            <Label fx:id="menuDescription"
                   text="Begin the Ashgrove containment operation."
                   styleClass="horror-menu-description"/>
            <Label text="↑ / ↓  NAVIGATE     ENTER  SELECT"
                   styleClass="horror-menu-hint"/>
        </VBox>
    </AnchorPane>
</StackPane>
